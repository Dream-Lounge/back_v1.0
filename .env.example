# ========== Database (Supabase PostgreSQL) ==========
# 운영 API는 DML만 허용된 dreamlounge_backend 계정을 사용합니다.
# Shared Pooler 사용 시 사용자명은 dreamlounge_backend.[project-ref] 형식입니다.
# 비밀번호의 @, #, / 등 URL 예약 문자는 percent-encoding 하세요. (@ -> %40)
DATABASE_URL=postgresql+psycopg://dreamlounge_backend.your-project:[runtime-password]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require
# Alembic 실행에만 사용하는 관리자 연결입니다. 운영 API 프로세스에는 주입하지 마세요.
MIGRATION_DATABASE_URL=postgresql+psycopg://postgres.your-project:[admin-password]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require

# ========== 환경 설정 ==========
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_DEBUG=True
DB_POOL_SIZE=12
DB_MAX_OVERFLOW=8
DB_POOL_TIMEOUT_SECONDS=15
DB_POOL_RECYCLE_SECONDS=300

# ========== JWT 설정 ==========
SECRET_KEY=your-super-secret-key-change-this-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
MAX_ACTIVE_SESSIONS_PER_USER=5

# ========== Supabase ==========
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=sb_publishable_your-publishable-key
SUPABASE_SERVICE_KEY=sb_secret_your-backend-secret-key
SUPABASE_STORAGE_BUCKET=club-images
# Supabase ES256 공개키를 컨테이너 메모리에 보관하는 시간
SUPABASE_JWKS_CACHE_SECONDS=600

# ========== Frontend ==========
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS='["http://localhost:5173", "http://localhost:3000", "http://localhost:8000"]'
# 외부 API가 /back-v1-0/api/v1로 공개될 때만 /back-v1-0으로 설정
COOKIE_PATH_PREFIX=

# ========== 요청 제한 ==========
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
LOGIN_IP_MAX_ATTEMPTS=500
REGISTRATION_IP_MAX_PER_HOUR=500
IMAGE_UPLOAD_MAX_PER_HOUR=20
# 신뢰할 수 있는 리버스 프록시가 X-Forwarded-For를 덮어쓰는 경우에만 true
TRUST_PROXY_HEADERS=False
# true일 때 요청을 직접 전달하는 프록시의 CIDR만 지정 (예: '["10.0.0.0/8"]')
TRUSTED_PROXY_CIDRS='[]'
